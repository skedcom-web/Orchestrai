# Copy this to .env (gitignored) and fill in real values before `npm run deploy`.
# These are runtime env vars for the deployed Cloud Functions — NEVER ship them to the browser.

# OpenRouter API key — obtain from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default model slug. Override per-call from the admin UI.
# Recommended budget option: qwen/qwen-2.5-72b-instruct
# Other useful options: anthropic/claude-3.5-haiku, openai/gpt-4o-mini
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# Optional: required by OpenRouter for analytics + rate-limit identification
OPENROUTER_REFERER=https://vthinkorchestrai-academy.web.app
OPENROUTER_APP_NAME=OrchestrAI Academy

# Optional: GitHub token for higher-rate file-fetching (60 req/h anonymous → 5000 authed).
# A read-only personal-access token is enough.
GITHUB_TOKEN=
