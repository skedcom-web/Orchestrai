# ── OpenRouter ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
OPENROUTER_REFERER=https://vthinkorchestrai-academy.web.app
OPENROUTER_APP_NAME=OrchestrAI Academy

# ── GitHub (optional — increases rate limit from 60 to 5000 req/hr) ───────────
GITHUB_TOKEN=

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Service security ─────────────────────────────────────────────────────────
# Set this to a strong random string and pass the same value in the
# x-api-key request header from your Firebase Hosting app.
REVIEW_SERVICE_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
ALLOWED_ORIGIN=https://vthinkorchestrai-academy.web.app
